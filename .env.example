# 雪涼云前端环境变量样例。复制为 .env.local / .env.production 使用。
# 所有变量均有内置默认值（见 src/api/env.ts），此处只列需要覆盖的项。

# 后端 API 地址（开发默认 http://localhost:9898，生产默认 https://api.yukiryou.icu）
#VITE_API_BASE_URL=http://localhost:9898

# 站点自身地址（用于分享链接 / SSG 预渲染）
#VITE_SITE_URL=https://cloud.yukiryou.icu

# 图片 CDN（Pixiv 代理）
#VITE_IMAGE_CDN_URL=https://i.yukiryou.icu

# 随机背景图服务
#VITE_BG_IMAGE_URL=https://img.yukiryou.icu/pic?img=ua

# 默认头像
#VITE_DEFAULT_AVATAR_URL=

# 阿里云验证码 SDK / ESA 前缀 / 场景 ID（生产请在环境变量注入，避免依赖源码默认值）
#VITE_CAPTCHA_SDK_SRC=https://o.alicdn.com/captcha-frontend/aliyunCaptcha/AliyunCaptcha.js
#VITE_CAPTCHA_PREFIX=esa-xxxx
#VITE_CAPTCHA_SCENE_ID=xxxx

# E2E / 本地开发：启用 mocks/api-mock.ts 适配器（生产构建会被静态剔除）
#VITE_USE_API_MOCKS=true
