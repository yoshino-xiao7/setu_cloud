{
  "name": "xueliang-frontend",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --host 127.0.0.1 --port 4173",
    "build": "npm run typecheck && vite build && npm run generate:sitemap",
    "check": "npm run lint && npm run typecheck && npm run build && npm run check:build-budget",
    "check:build-budget": "tsx scripts/check-build-budget.ts",
    "generate:sitemap": "npx tsx scripts/generate-sitemap.ts",
    "preview": "vite preview",
    "test:e2e": "playwright test --project=mobile-chrome --workers=1",
    "test:e2e:all": "playwright test --workers=1",
    "test:e2e:desktop": "playwright test --project=chromium --workers=1",
    "test:e2e:ui": "playwright test --ui --workers=1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@github/webauthn-json": "^2.1.1",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/head": "^2.0.0",
    "ali-oss": "^6.23.0",
    "axios": "^1.13.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.21",
    "echarts": "^6.0.0",
    "html-to-image": "^1.11.13",
    "naive-ui": "^2.43.2",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.24",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@playwright/test": "^1.61.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.4.1",
    "rollup": "4.29.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-compression2": "^2.5.3",
    "vue-tsc": "^3.1.4"
  }
}
