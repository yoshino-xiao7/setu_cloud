{
  "headers": [
    {
      "source": "/.well-known/*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "/index.html",
      "status": 200
    }
  ]
}
